# Copy to .env (root) and apps/dapp/.env as needed.
# Never commit real private keys.

# Public demo recipient on Sepolia
DEMO_SEPOLIA_ADDRESS=0x86b3A00CcE3569582CE7E5601Cc917E8720b03A9

# RPC endpoints (optional overrides)
SEPOLIA_RPC_URL=https://rpc.sepolia.org
MAINNET_RPC_URL=https://cloudflare-eth.com

# Hardhat deploy (Sepolia) — use a funded throwaway key only
DEPLOYER_PRIVATE_KEY=

# DApp (apps/dapp/.env)
VITE_SEPOLIA_RPC_URL=https://rpc.sepolia.org
VITE_MAINNET_RPC_URL=https://cloudflare-eth.com
VITE_GUESTBOOK_ADDRESS=
VITE_AETHER_TOKEN_ADDRESS=
